# ---------------------------------------------------------------
# SecureID — copy to .env and fill in. NEVER commit .env.
# Every value below is a placeholder. No real credentials here.
# ---------------------------------------------------------------

# --- Database (Supabase, free tier) ----------------------------
# Supabase dashboard → Project Settings → Database → Connection string.
# For Vercel use the CONNECTION POOLING string (port 6543), not 5432.
# If your password contains @ : / ? # or & you MUST url-encode it
# (@ becomes %40), otherwise the connection string parses wrongly.
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# --- Auth ------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Never reuse across environments.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=12

# --- Email OTP -------------------------------------------------
# EMAIL_MODE: smtp | resend | mock
#   smtp   — Gmail app password, Brevo, etc. Free. Reaches any inbox.
#   mock   — prints the code to the server console. No email sent.
EMAIL_MODE=mock
EMAIL_FROM=SecureID <your-address@gmail.com>

# Gmail: use a DEDICATED account with 2-Step Verification on, then
# Google Account → Security → App passwords → generate a 16-character
# password. Use that here. NEVER your normal Gmail password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-address@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# Only needed when EMAIL_MODE=resend
RESEND_API_KEY=

# --- SMS OTP ---------------------------------------------------
# SMS_MODE: mock | http
#   mock — no SMS is sent. The OTP is still generated with a CSPRNG,
#          hashed before storage, expired, attempt-limited and
#          single-use. Only the transport is stubbed.
#   http — a generic HTTP gateway configured below.
#
# Real SMS to Indian (+91) numbers requires a paid, KYC-verified,
# DLT-registered sender. No free tier exists for that route, so mock
# is the default and the assignment demo runs on it.
SMS_MODE=mock

# --- TEST-ONLY OTP retrieval (for evaluator testing) ------------
# Because SMS is simulated, a simulated code never reaches a phone, and
# on a deployed instance the server console is not visible. This gives an
# evaluator a way to read the code back.
#
#   GET /api/test/otp?challengeId=<uuid>
#   GET /api/test/otp?mobile=9876543210
#   GET /api/test/otp?email=someone@example.com
#   Header: x-test-token: <TEST_OTP_TOKEN>
#
# The NORMAL API never returns an OTP. This is a separate, token-gated
# route that is only mounted when all of the following hold:
#   ENABLE_TEST_OTP_API=true, TEST_OTP_TOKEN set (16+ chars), SMS_MODE=mock
#
# TRADE-OFF: OTPs are stored only as a SHA-256 hash, which cannot be
# reversed. To hand a code back, the plaintext is also written to
# otp_challenges.test_otp — but ONLY while this flag is on. With it off
# (the default) that column stays NULL and no plaintext OTP exists.
# Turn this OFF for any deployment holding real user accounts.
ENABLE_TEST_OTP_API=false
TEST_OTP_TOKEN=

# Only needed when SMS_MODE=http
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_BODY={"to":"{{to}}","message":"{{message}}"}
SMS_HTTP_AUTH_HEADER=
SMS_HTTP_AUTH_VALUE=

# --- Misc ------------------------------------------------------
PORT=3000
# Comma-separated. Only needed if the frontend is hosted separately.
ALLOWED_ORIGINS=
# Minimum password strength to register: weak | medium | strong
MIN_PASSWORD_STRENGTH=medium
